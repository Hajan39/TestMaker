# Přihlašování. S AUTH_SECRET se aplikace chrání účty; bez něj běží lokálně
# dokořán pod výchozím účtem ze seedu a na Vercelu se neotevře vůbec.
# Tajemství vyrob: openssl rand -hex 32
# Účty zakládá `pnpm --filter @testmaker/web uzivatel`, ne proměnná prostředí.
AUTH_SECRET=

# Přihlášení školním účtem Google (volitelné, vedle hesla). Bez GOOGLE_CLIENT_ID
# se tlačítko na přihlašovací stránce nenabídne. Adresa návratu musí v Google
# Cloudu sedět na znak.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/prihlaseni/google/zpet
# GOOGLE_HD=zsnekde.cz

# Lokálně SQLite soubor; na Vercelu Turso (libsql://… + token)
DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=

# Cíl přenosu knihovny na server (scripts/push-remote.ts). Schválně jinými
# proměnnými než DATABASE_URL: ta míří na zdroj, tedy na lokální soubor, a
# kdyby se z ní bral i cíl, stačilo by zapomenout jednu proměnnou a knihovna
# by přepsala sama sebe. Adresu i token vypíše `turso db show <jméno>`.
# TARGET_DATABASE_URL=libsql://…
# TARGET_DATABASE_AUTH_TOKEN=
# Zdroj přenosu; bez něj se bere apps/web/local.db.
# SOURCE_DATABASE_URL=file:./local.db

# AI pro generování otázek
# ------------------------
# Žebříček modelů v pořadí, v jakém se zkoušejí: `poskytovatel:model`, čárkou.
# Když modelu dojde limit, pokračuje se dalším — placený model patří na konec.
# Poskytovatelé: google, openrouter, anthropic. Bez AI_MODELS se použije
# google:gemini-flash-latest. Položky, ke kterým tu chybí klíč, se přeskakují;
# bez jediného použitelného modelu se generování v rozhraní skryje.
# AI_MODELS=google:gemini-flash-latest,openrouter:<model z openrouter.ai/models>
#
# Google AI Studio → API keys. Od září 2026 platí jen klíče typu „Auth".
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenRouter (platí se po tokenech) → openrouter.ai/keys
# OPENROUTER_API_KEY=
# Anthropic Console (API klíč; předplatné Claude Max tu nefunguje — na otázky
# přes předplatné je v Claude Code příkaz /otazky)
# ANTHROPIC_API_KEY=
#
# Nastavení generování (velikost úseků, počty) je v packages/core/src/ai/settings.ts.

# Tajemství pro plánovač generování (cron na Synology při self-hostingu). Bez něj
# cron k frontě nepustíme. Na Vercelu Hobby plánovač neběží — cron je tam nejvýš
# denní a rozvrh po minutě shodí build; hromadné generování se spouští z počítače
# (pnpm --filter @testmaker/web generate:bulk).
CRON_SECRET=
