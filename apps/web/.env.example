# Lokálně SQLite soubor; na Vercelu Turso (libsql://… + token)
DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=

# AI pro generování otázek. Bez klíče (ani tokenu) u žádného z poskytovatelů
# se generování v UI skryje. Když AI_PROVIDER není nastavený, poskytovatel se
# pozná podle toho, který klíč níž vyplníš (přednost má Anthropic, pak Google).
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Žebříček modelů: seznam oddělený čárkami, ve kterém se pokračuje, když
# modelu dojde denní limit nebo je přetížený. Položka smí určit i poskytovatele
# (`poskytovatel:model`), takže jde míchat Gemini a Claude; bez dvojtečky patří
# model poskytovateli podle AI_PROVIDER. Přepíná se po dávce, ne po tématu —
# otázky, které už jsou uložené, zůstávají a zbytek dogeneruje další model.
# Placený model se zapojí jedině tím, že ho sem napíšeš; sám se nic nepřepne.
# Když dojde celý žebříček, generování skončí chybou posledního modelu a to,
# co se do té chvíle vygenerovalo, zůstává v tématu uložené.
# Bez AI_MODELS se použije jediný model podle AI_PROVIDER a AI_MODEL (jako dřív).
# Modely poskytovatele, ke kterému tu není klíč, se přeskakují.
# AI_MODELS=google:gemini-flash-latest,google:gemini-flash-lite-latest

# Místo klíče lze použít přihlášení přes `ant auth login` (jednou, přes prohlížeč).
# Token je krátkodobý, proto ho sem needituj ručně — spouštěj `pnpm dev:ant`,
# které si ho při startu vyžádá samo. Pro vypsání: ant auth print-credentials --env
# ANTHROPIC_AUTH_TOKEN=

# Google Gemini — alternativa k Anthropicu, klíč z Google AI Studio.
# Výchozí model je gemini-flash-latest. Modely řady "pro" mají na bezplatném
# tarifu nulový limit a skončí chybou o překročené kvótě; když je "flash"
# přetížený, funguje gemini-flash-lite-latest.
# AI_PROVIDER=google
# AI_MODEL=gemini-flash-latest
# GOOGLE_GENERATIVE_AI_API_KEY=

# Lokální model (fáze 2)
# AI_PROVIDER=ollama
# AI_MODEL=qwen3:14b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# Sdílené heslo do aplikace. Prázdné = aplikace běží bez přihlášení — to platí
# jen lokálně; v nasazení na Vercelu se bez hesla neotevře vůbec a odpoví 503.
APP_PASSWORD=
# Tajemství pro podpis přihlašovací cookie. Vyrob: openssl rand -hex 32
# Bez něj se s nastaveným APP_PASSWORD nedá přihlásit, takže aplikace taky odpoví 503.
AUTH_SECRET=

# Tajemství pro plánovač generování (cron na Synology při self-hostingu). Bez něj
# cron k frontě nepustíme. Na Vercelu Hobby plánovač neběží — cron je tam nejvýš
# denní a rozvrh po minutě shodí build; hromadné generování se spouští z počítače
# (pnpm --filter @testmaker/web generate:bulk).
CRON_SECRET=
